  "name": "contact-details",
  "params": {
    "id": ""
  },
  "parentPageName": "contacts",
  "type": "page",
  "url": "/:id",
  "variables": [
    {
      "description": "The resolved contact",
      "name": "contact",
      "type": "property",
      "value": "null"
    },
    {
      "name": "$state",
      "type": "service"
    },
    {
      "body": "const id = ($ctrl.pageParameters && $ctrl.pageParameters.id) ? String($ctrl.pageParameters.id) : '';\nif (!id) {\n  $ctrl.contact = null;\n  return;\n}\nconst contacts = JSON.parse(localStorage.getItem('contacts') || '[]');\n$ctrl.contact = contacts.find(function(c) { return c && c.id === id; }) || null;",
      "description": "Resolves the contact from the URL parameter",
      "invokeOnLoad": true,
      "isAsync": false,
      "name": "resolveContact",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": [
        "$ctrl.pageParameters.id"
      ]
    },
    {
      "body": "if ($ctrl.contact && $ctrl.contact.id) {\n  $ctrl.$state.go('contacts.contact-edit', { id: $ctrl.contact.id });\n}",
      "description": "Navigate to edit page",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "goToEdit",
      "parameters": [],
      "returnType": {
        "name": "void"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "if (!$ctrl.contact || !$ctrl.contact.id) return;\nconst contacts = JSON.parse(localStorage.getItem('contacts') || '[]');\nconst updatedContacts = contacts.filter(function(c) { return c.id !== $ctrl.contact.id; });\nlocalStorage.setItem('contacts', JSON.stringify(updatedContacts));\n$ctrl.$state.go('contacts', {}, { reload: true });",
      "description": "Delete the contact",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "deleteContact",
      "parameters": [],
      "returnType": {
        "name": "void"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.$state.go('contacts');",
      "description": "Navigate back to the contacts list",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "goBack",
      "parameters": [],
      "returnType": {
        "name": "void"
      },
      "type": "method",
      "watch": []
    }
  ]
}
