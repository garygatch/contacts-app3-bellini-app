  "name": "contact-edit",
  "params": {
    "id": ""
  },
  "parentPageName": "contacts",
  "type": "page",
  "url": "/:id/edit",
  "variables": [
    {
      "name": "$state",
      "type": "service"
    },
    {
      "description": "The clone of the contact being edited.",
      "name": "editContact",
      "type": "property",
      "value": "{}"
    },
    {
      "body": "const id = $ctrl.pageParameters && $ctrl.pageParameters.id;\nif (!id) return;\nconst contacts = JSON.parse(localStorage.getItem('contacts') || '[]');\nconst found = contacts.find(function(c) { return String(c.id) === String(id); });\nif (found) {\n  $ctrl.editContact = Object.assign({}, found);\n} else {\n  $ctrl.editContact = {};\n}",
      "description": "",
      "invokeOnLoad": true,
      "isAsync": false,
      "name": "initEdit",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "const contacts = JSON.parse(localStorage.getItem('contacts') || '[]');\nconst index = contacts.findIndex(function(c) { return String(c.id) === String($ctrl.editContact.id); });\nif (index !== -1) {\n  contacts[index] = $ctrl.editContact;\n} else if ($ctrl.editContact.id) {\n  contacts.push($ctrl.editContact);\n}\nlocalStorage.setItem('contacts', JSON.stringify(contacts));\n$ctrl.$state.go('contacts.contact-details', { id: $ctrl.editContact.id }, { reload: true });",
      "description": "",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "updateContact",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.$state.go('contacts.contact-details', { id: $ctrl.editContact.id });",
      "description": "Navigate back to details without saving.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "cancelEdit",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    }
  ]
}
